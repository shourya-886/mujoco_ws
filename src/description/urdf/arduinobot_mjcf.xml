<mujoco model="arduinobot">
  <compiler angle="radian" meshdir="../meshes"/>
  <option integrator="implicitfast"/>

  <asset>
    <mesh name="basement" file="basement.STL" scale="0.01 0.01 0.01"/>
    <mesh name="base_plate" file="base_plate.STL" scale="0.01 0.01 0.01"/>
    <mesh name="forward_drive_arm" file="forward_drive_arm.STL" scale="0.01 0.01 0.01"/>
    <mesh name="horizontal_arm" file="horizontal_arm.STL" scale="0.01 0.01 0.01"/>
    <mesh name="claw_support" file="claw_support.STL" scale="0.01 0.01 0.01"/>
    <mesh name="right_finger" file="right_finger.STL" scale="0.01 0.01 0.01"/>
    <mesh name="left_finger" file="left_finger.STL" scale="0.01 0.01 0.01"/>

    <!--defining ground plane-->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <!-- initialising ground plane-->
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Reach-task target. Free-floating visual marker, no physics/collision.
         Placed near the gripper's resting workspace (gripper_right sits around
         x=-0.06, y=0.95, z=1.35 at qpos=0) so it's actually reachable. Nudge
         this as you observe the arm's real range of motion in the viewer. -->
    <site name="target" pos="0.1 0.7 1.2" size="0.03" rgba="0 1 0 0.6"/>

    <geom pos="-0.5 -0.5 0" quat="1 0 0 0" type="mesh" mesh="basement"/>
    <body name="base_plate" pos="0 0 0.304">
      <inertial pos="0.0374568 0.0391323 0.0686462" quat="-0.263343 0.742225 -0.0620609 0.613107" mass="0.0545311" diaginertia="3.36311e-05 2.67876e-05 2.20813e-05"/>
      <joint name="joint_1" pos="0 0 0" axis="0 0 1" range="-1.5708 1.5708" actuatorfrcrange="-30 30"/>
      <geom pos="-0.39 -0.39 -0.56" quat="1 0 0 0" type="mesh" mesh="base_plate"/>
      <body name="forward_drive_arm" pos="-0.02 0 0.35">
        <inertial pos="0.0413569 0.0153019 0.00650451" quat="-0.00123056 0.695852 0.0111452 0.718098" mass="0.0163292" diaginertia="1.25112e-05 1.17031e-05 1.27568e-06"/>
        <joint name="joint_2" pos="0 0 0" axis="1 0 0" range="-1.5708 1.5708" actuatorfrcrange="-30 30"/>
        <geom pos="0.19 0.06 -0.08" quat="0.5 0.5 -0.5 0.5" type="mesh" mesh="forward_drive_arm"/>
        <body name="horizontal_arm" pos="0 0 0.8">
          <inertial pos="0.0421175 0.364072 0.00667409" quat="0.478042 0.506456 -0.497211 0.517455" mass="0.019282" diaginertia="0.00323467 0.00321911 1.76903e-05"/>
          <joint name="joint_3" pos="0 0 0" axis="1 0 0" range="-1.5708 1.5708" actuatorfrcrange="-30 30"/>
          <geom pos="-0.03 -0.4 -0.06" quat="0.5 0.5 0.5 0.5" type="mesh" mesh="horizontal_arm"/>
          <geom pos="0 0.77 -0.15" quat="0.707107 0 0 0.707107" type="mesh" mesh="claw_support"/>
          <body name="gripper_right" pos="-0.04 0.95 -0.1">
            <inertial pos="0.0291372 0.00819303 0.0020982" quat="-0.0891948 0.679743 -0.137753 0.714855" mass="0.00183079" diaginertia="5.62903e-07 5.41871e-07 2.60264e-08"/>
            <joint name="joint_4" pos="0 0 0" axis="0 0 1" range="-1.5708 0" actuatorfrcrange="-30 30"/>
            <geom pos="-0.1 0.5 -0.1" quat="0.707107 0 0 -0.707107" type="mesh" mesh="right_finger"/>
            <!-- Gripper-tip reference point for the reach task's reward.
                 Placed at the body origin for now  nudge pos= once you see
                 in the viewer where the actual fingertip mesh sits relative
                 to this body's frame. -->
            <site name="gripper_tip" pos="0 0 0" size="0.015" rgba="1 0 0 1"/>
          </body>
          <body name="gripper_left" pos="-0.22 0.95 -0.1">
            <inertial pos="0.0281243 0.00609915 0.00213881" quat="0.093175 0.679681 0.137481 0.714458" mass="0.00173688" diaginertia="5.22755e-07 5.03338e-07 2.56067e-08"/>
            <joint name="joint_5" pos="0 0 0" axis="0 0 1" range="0 1.5708" actuatorfrcrange="-30 30"/>
            <geom pos="-0.04 0.5 -0.1" quat="0.707107 0 0 -0.707107" type="mesh" mesh="left_finger"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <!-- The jaws are mechanically coupled by gripper_gear below.  Their visual
       STL meshes overlap during normal motion, so they must not contact each other. -->
  <contact>
    <exclude body1="gripper_right" body2="gripper_left"/>
  </contact>
  <equality>
  <joint name="gripper_gear"
        joint1="joint_5"
        joint2="joint_4"
        polycoef="0 -1 0 0 0"/>
  </equality>

  <!-- Temporary test limit: ±2.0 N-m. This exceeds a real SG90's ±0.1765 N-m rating. -->
  <actuator>
    <position name="servo_joint_1" joint="joint_1" kp="5" dampratio="1" timeconst="0.02"
              ctrlrange="-1.5708 1.5708" forcerange="-3 3"/>
    <position name="servo_joint_2" joint="joint_2" kp="5" dampratio="1" timeconst="0.02"
              ctrlrange="-1.5708 1.5708" forcerange="-3 3"/>
    <position name="servo_joint_3" joint="joint_3" kp="5" dampratio="1" timeconst="0.02"
              ctrlrange="-1.5708 1.5708" forcerange="-3 3"/>
    <!-- Drive one jaw only; gripper_gear moves joint_5 in the opposite direction. -->
    <position name="servo_gripper" joint="joint_4" kp="5" dampratio="1" timeconst="0.02"
              ctrlrange="-1.5708 0" forcerange="-3 3"/>
  </actuator>
</mujoco>